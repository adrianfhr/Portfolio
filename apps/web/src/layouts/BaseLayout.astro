---
import AuthButton from '../modules/auth/components/AuthButton';
import RateLimitBadge from '../modules/auth/components/RateLimitBadge';

const {
  title = 'Interactive AI Engineering Portfolio',
  description = 'Astro shell for the portfolio platform and FastAPI gateway.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <style is:global>
      :root {
        color-scheme: dark;
        --background: #07111d;
        --background-alt: #0f1c2c;
        --surface: rgba(8, 18, 30, 0.82);
        --surface-strong: rgba(11, 24, 38, 0.96);
        --border: rgba(155, 185, 217, 0.16);
        --border-strong: rgba(155, 185, 217, 0.28);
        --text: #e9f1fb;
        --muted: #95abc4;
        --accent: #71d6ff;
        --accent-strong: #43b5ff;
        --success: #6cf0b1;
        --warning: #ffcf70;
        --shadow: 0 28px 80px rgba(0, 0, 0, 0.44);
        --mono: 'SFMono-Regular', 'Consolas', 'Liberation Mono', monospace;
        --sans: 'Segoe UI', 'Aptos', 'Helvetica Neue', Arial, sans-serif;
      }

      * {
        box-sizing: border-box;
      }

      html {
        min-height: 100%;
        background:
          radial-gradient(circle at top left, rgba(113, 214, 255, 0.18), transparent 34%),
          radial-gradient(circle at top right, rgba(108, 240, 177, 0.1), transparent 28%),
          linear-gradient(180deg, #08101b 0%, #040a12 100%);
      }

      body {
        margin: 0;
        min-height: 100vh;
        color: var(--text);
        font-family: var(--sans);
        background:
          linear-gradient(rgba(255, 255, 255, 0.02) 1px, transparent 1px),
          linear-gradient(90deg, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
          linear-gradient(180deg, #07111d 0%, #040a12 100%);
        background-size: 56px 56px, 56px 56px, auto;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      main {
        width: min(1180px, calc(100vw - 2rem));
        margin: 0 auto;
        padding: 2rem 0 3rem;
      }

      .shell {
        position: relative;
      }

      .navbar {
        position: sticky;
        top: 0;
        z-index: 50;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding: 0.75rem 1.25rem;
        border-bottom: 1px solid var(--border);
        background: rgba(7, 17, 29, 0.72);
        backdrop-filter: blur(18px);
      }

      .navbar-brand {
        font-weight: 700;
        font-size: 1rem;
        letter-spacing: -0.02em;
      }

      .navbar-actions {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .hero {
        position: relative;
        overflow: hidden;
        padding: 2rem;
        border: 1px solid var(--border);
        border-radius: 28px;
        background: linear-gradient(180deg, rgba(11, 24, 38, 0.92), rgba(7, 15, 25, 0.94));
        box-shadow: var(--shadow);
      }

      .hero::before {
        content: '';
        position: absolute;
        inset: auto -8% -45% auto;
        width: 18rem;
        height: 18rem;
        border-radius: 999px;
        background: radial-gradient(circle, rgba(113, 214, 255, 0.3), transparent 65%);
        filter: blur(8px);
        pointer-events: none;
      }

      .eyebrow {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        margin-bottom: 1rem;
        padding: 0.4rem 0.75rem;
        border: 1px solid var(--border);
        border-radius: 999px;
        color: var(--muted);
        font-size: 0.78rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        font-family: var(--mono);
      }

      .eyebrow::before {
        content: '';
        width: 0.55rem;
        height: 0.55rem;
        border-radius: 999px;
        background: var(--success);
        box-shadow: 0 0 0 0.35rem rgba(108, 240, 177, 0.12);
      }

      .hero-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(18rem, 0.9fr);
        gap: 1.25rem;
        align-items: start;
      }

      .hero-copy h1 {
        margin: 0;
        font-size: clamp(2.5rem, 6vw, 5rem);
        line-height: 0.95;
        letter-spacing: -0.05em;
        max-width: 11ch;
      }

      .hero-copy p {
        margin: 1rem 0 0;
        max-width: 62ch;
        color: var(--muted);
        font-size: 1rem;
        line-height: 1.7;
      }

      .actions {
        display: flex;
        flex-wrap: wrap;
        gap: 0.75rem;
        margin-top: 1.5rem;
      }

      .button {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-height: 2.8rem;
        padding: 0.85rem 1rem;
        border-radius: 14px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.02);
        color: var(--text);
        font-weight: 600;
        transition: transform 150ms ease, border-color 150ms ease, background 150ms ease;
      }

      .button:hover {
        transform: translateY(-1px);
        border-color: var(--border-strong);
        background: rgba(255, 255, 255, 0.05);
      }

      .button.primary {
        border-color: rgba(113, 214, 255, 0.34);
        background: linear-gradient(135deg, rgba(71, 157, 255, 0.35), rgba(113, 214, 255, 0.14));
      }

      .button.primary:hover {
        border-color: rgba(113, 214, 255, 0.5);
      }

      .hero-panel {
        position: relative;
        padding: 1.1rem;
        border-radius: 22px;
        border: 1px solid var(--border);
        background: rgba(2, 9, 18, 0.55);
      }

      .panel-title {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        margin-bottom: 1rem;
        font-size: 0.82rem;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--muted);
        font-family: var(--mono);
      }

      .status-dot {
        width: 0.7rem;
        height: 0.7rem;
        border-radius: 999px;
        background: var(--success);
        box-shadow: 0 0 0 0.35rem rgba(108, 240, 177, 0.12);
      }

      .status-dot.degraded {
        background: var(--warning);
        box-shadow: 0 0 0 0.35rem rgba(255, 207, 112, 0.16);
      }

      .status-dot.down {
        background: #ff7b7b;
        box-shadow: 0 0 0 0.35rem rgba(255, 123, 123, 0.14);
      }

      .status-copy {
        display: grid;
        gap: 0.6rem;
      }

      .status-value {
        margin: 0;
        font-size: 2rem;
        font-weight: 700;
        letter-spacing: -0.04em;
      }

      .status-meta {
        display: grid;
        gap: 0.4rem;
        margin: 0;
        color: var(--muted);
        font-size: 0.92rem;
        line-height: 1.6;
      }

      .stack-grid {
        display: grid;
        grid-template-columns: repeat(12, minmax(0, 1fr));
        gap: 1rem;
        margin-top: 1rem;
      }

      .card {
        position: relative;
        padding: 1.15rem;
        border: 1px solid var(--border);
        border-radius: 22px;
        background: var(--surface);
        backdrop-filter: blur(18px);
        box-shadow: 0 18px 60px rgba(0, 0, 0, 0.24);
      }

      .card h2,
      .card h3 {
        margin: 0;
      }

      .card h2 {
        font-size: 1.1rem;
      }

      .card p {
        margin: 0.75rem 0 0;
        color: var(--muted);
        line-height: 1.65;
      }

      .card strong {
        color: var(--text);
      }

      .card .tag-row {
        display: flex;
        flex-wrap: wrap;
        gap: 0.55rem;
        margin-top: 1rem;
      }

      .tag {
        padding: 0.42rem 0.68rem;
        border-radius: 999px;
        border: 1px solid var(--border);
        background: rgba(255, 255, 255, 0.03);
        color: var(--muted);
        font-size: 0.82rem;
        font-family: var(--mono);
      }

      .span-7 {
        grid-column: span 7;
      }

      .span-5 {
        grid-column: span 5;
      }

      .span-4 {
        grid-column: span 4;
      }

      .list {
        margin: 0.9rem 0 0;
        padding: 0;
        list-style: none;
        display: grid;
        gap: 0.7rem;
      }

      .list li {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 0.75rem;
        padding: 0.85rem 0.95rem;
        border: 1px solid rgba(255, 255, 255, 0.08);
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.02);
      }

      .list li span:first-child {
        color: var(--muted);
      }

      .mono {
        font-family: var(--mono);
      }

      .error {
        color: #ffb8b8;
      }

      @media (max-width: 920px) {
        .hero-grid,
        .stack-grid {
          grid-template-columns: 1fr;
        }

        .span-7,
        .span-5,
        .span-4 {
          grid-column: span 1;
        }

        .hero {
          padding: 1.25rem;
        }
      }

      @media (max-width: 640px) {
        main {
          width: min(100vw - 1rem, 1180px);
          padding: 0.5rem 0 2rem;
        }

        .hero-copy h1 {
          max-width: 100%;
          font-size: clamp(2.25rem, 14vw, 3.5rem);
        }

        .button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <nav class="navbar">
      <a href="/" class="navbar-brand">Portfolio</a>
      <div class="navbar-actions">
        <RateLimitBadge client:load />
        <AuthButton client:load />
      </div>
    </nav>
    <slot />
    <script is:inline>
      // Capture rate limit headers from fetch responses for UI display
      const originalFetch = window.fetch;
      window.fetch = async function(...args) {
        const response = await originalFetch.apply(this, args);
        const remaining = response.headers.get('X-RateLimit-Remaining');
        const policy = response.headers.get('X-RateLimit-Policy');
        if (remaining !== null) {
          window.__lastRateLimitRemaining = remaining;
          window.__lastRateLimitPolicy = policy || '';
          window.dispatchEvent(new Event('rate-limit-update'));
        }
        return response;
      };
    </script>
  </body>
</html>
