---
import { STACK } from '../data/portfolio';
import SectionHead from './SectionHead.astro';
import MonoLabel from './MonoLabel.astro';

/*
 * Grid renders 2x2 on mobile and a single 4-col row on sm+. borderClass
 * reproduces the `gi < STACK.length - 1` right-divider from the single-row
 * layout, split so index 1 (last column on mobile, mid-row on sm+) only
 * gets its divider at sm+.
 */
const borderClass = (gi: number) => {
  if (gi === STACK.length - 1) return '';
  if (gi % 2 === 1) return 'sm:border-r sm:border-rule';
  return 'border-r border-rule';
};
---

<section id="stack" class="py-10 sm:py-[60px] px-5 sm:px-10 max-w-content mx-auto">
  <SectionHead n="03" title="Stack" sub="Tools I reach for first" />

  <div class="grid grid-cols-2 sm:grid-cols-4 border-t border-rule">
    {STACK.map((g, gi) => (
      <div
        class:list={[
          'py-[22px] px-[22px] pb-7 border-b border-rule',
          borderClass(gi),
        ]}
      >
        <MonoLabel>{g.group}</MonoLabel>
        <ul class="mt-[14px] p-0 list-none grid gap-2">
          {g.items.map((it) => (
            <li class="text-[15px] text-ink-1 tracking-[-0.005em]">{it}</li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
