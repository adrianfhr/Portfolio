---
import { Image } from 'astro:assets';
import type { Profile } from '../data/portfolio';
import MonoLabel from './MonoLabel.astro';
import portraitImg from '../assets/portrait.jpg';

interface Props {
  profile: Profile;
}
const { profile } = Astro.props;

const stats = [
  { k: 'shipped',   v: '5+ systems',  s: 'edge AI, backend, IoT'  },
  { k: 'stack',     v: 'Go · Python', s: '+ PyTorch, WebRTC'       },
  { k: 'currently', v: 'AI Engineer', s: 'at Synapsis · Oct 2025'  },
  { k: 'education', v: 'B.Eng IST',   s: 'ITB · graduated 2025'    },
];
---

<section class="py-24 pb-20 px-10 max-w-content mx-auto">
  <!-- Main hero grid: bio left · portrait right -->
  <div class="grid grid-cols-[minmax(0,1fr)_260px] gap-16 items-end">
    <div>
      <MonoLabel>{profile.role}</MonoLabel>

      <h1 class="font-display text-[clamp(52px,7vw,96px)] leading-[0.98] tracking-[-0.04em] font-medium mt-[18px] mb-6 text-ink-1">
        {profile.name.split(' ')[0]}.<br />
        <span class="font-serif italic font-normal text-ink-2">builds quiet</span>{' '}
        <span class="font-serif italic font-normal text-ink-2">infrastructure</span>
      </h1>

      <p class="text-[19px] leading-[1.55] text-ink-2 max-w-[620px] [text-wrap:pretty] m-0">
        {profile.blurb}
      </p>
    </div>

    <!-- Portrait -->
    <aside class="self-end">
      <div class="relative w-full aspect-[3/4] overflow-hidden rounded-xl border border-rule">
        <Image
          src={portraitImg}
          alt={profile.name}
          widths={[260, 520]}
          sizes="260px"
          class="absolute inset-0 w-full h-full object-cover object-center"
        />
      </div>
    </aside>
  </div>

  <!-- Stats bar -->
  <div class="mt-20 grid grid-cols-4 border-t border-b border-rule">
    {stats.map((c, i) => (
      <div class:list={['py-[22px] px-5', { 'border-l border-rule': i > 0 }]}>
        <MonoLabel>{c.k}</MonoLabel>
        <div class="text-[18px] text-ink-1 mt-2 tracking-[-0.01em]">{c.v}</div>
        <div class="text-[13px] text-ink-3 mt-1">{c.s}</div>
      </div>
    ))}
  </div>
</section>
